# Copy to .env and edit if the defaults clash with something already running.
# There are no LinkedIn credentials here on purpose: you log in by hand through
# the noVNC window once, and the session is kept in the Docker volume.

# Dashboard, published on 127.0.0.1 only.
DASHBOARD_PORT=8765

# noVNC, used only for the one-time login. Also 127.0.0.1 only.
NOVNC_PORT=6080

# Container timezone, used for the daily like cap and log timestamps.
TZ=Europe/London
